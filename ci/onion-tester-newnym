## AI-Assisted

## Signal NEWNYM on the CI Tor control port so the next onion-tester attempt
## is an INDEPENDENT trial rather than a replay of the previous one.
##
## Tor caches client-side failure state per onion service: the fetched (or
## un-fetchable) hidden-service descriptor and the intro points that did not
## answer. Re-probing the same .onion through the same client minutes later
## therefore tends to reproduce the previous verdict even when the service is
## reachable from any other client. NEWNYM purges that state
## (hs_client_purge_state) and marks existing circuits unusable, so the retry
## re-fetches the descriptor over fresh circuits.
##
## Exit codes:
##   0 = signal accepted
##   1 = control port unreachable / auth failed / signal rejected

import sys

sys.dont_write_bytecode = True

import os

from stem import Signal
from stem.control import Controller


def env_int(name, default):
    """A positive-int env override, else the default (bad/empty value ignored)."""
    try:
        val = int(os.environ.get(name, "") or default)
    except ValueError:
        return default
    return val if val >= 1 else default


def main():
    control_port = env_int("ONION_TESTER_CONTROL_PORT", 9051)
    try:
        with Controller.from_port(port=control_port) as controller:
            controller.authenticate()
            controller.signal(Signal.NEWNYM)
            wait_seconds = controller.get_newnym_wait()
    except Exception as exc:
        print(
            "onion-tester-newnym: NEWNYM on control port %d failed: %s"
            % (control_port, exc),
            file=sys.stderr,
        )
        sys.exit(1)

    print(
        "onion-tester-newnym: NEWNYM accepted on control port %d; "
        "Tor rate-limits the next one for %.0fs"
        % (control_port, wait_seconds)
    )
    sys.exit(0)


if __name__ == "__main__":
    main()
